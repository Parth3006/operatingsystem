--------Create XML file transform student records into HTML table format using XSLT ---------------




---------------------------------- students.xml ---------------------------
<?xml version="1.0" encoding="UTF-8"?> 
<?xml-stylesheet type="text/xsl" href="students.xsl"?> 
<students> 
<student> 
<n>Rahul</n> 
<branch>CSE</branch> 
<marks>88</marks> 
</student> 
<student> 
<n>Priya</n> 
<branch>IT</branch> 
<marks>92</marks> 
</student> 
</students> 


---------------------- students.xsl -------------------------------------- 
<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"> 
<xsl:template match="/"> 
<html> 
<body> 
<h2>Student Records</h2> 
<table border="1"> 
<tr> 
<th>Name</th> 
<th>Branch</th> 
<th>Marks</th> 
</tr> 
<xsl:for-each select="students/student"> 
<tr> 
<td><xsl:value-of select="name"/></td> 
<td><xsl:value-of select="branch"/></td> 
<td><xsl:value-of select="marks"/></td> 
</tr> 
</xsl:for-each> 
</table> </body> 
</html> 
</xsl:template> 
</xsl:stylesheet> 





----------------Build a React application demonstrating  Hooks (useState, useEffect) ----------------------


 
import React,{useState,useEffect} from "react"; 
function App() { 
 	const[count,setCount]=useState(0); 
 	useEffect(()=> 
 	{ 
 	 	console.log("Count update:",count); 
 	}, 
[count] 
 	); 	 
  return ( 
     <div style={{textAlign:"center",marginTop:"250px"}}> 
 	 <h2>{count}</h2> 
 	 <button onClick={()=>setCount(count+1)}>Increment</button> 
 	 <button onClick={()=>setCount(count-1)}>Decrement</button> 
 	 </div>   
  ); 
} 
 
export default App; 

----------------------------------------AJAX---------------------------------

<!DOCTYPE html>
<html>
<body>
<h1>Fetch data using AJAX</h1>
<button onclick="loadData()">Get Data</button>
<div id="output"></div>

<script>
function loadData() {
  var x = new XMLHttpRequest();
  x.onload = function() {
    var d = JSON.parse(this.responseText), t = "<table border=1>";
    for (var i = 0; i < d.length; i++) {
      t += "<tr><td>"+d[i].Name+"</td><td>"+d[i].Title+"</td><td>"+d[i].Total+"</td><td>"+d[i].Remark+"</td></tr>";
    }
    document.getElementById("output").innerHTML = t + "</table>";
  };
  x.open("GET","http://172.16.5.154:4000/api/getAll/harshawar",true);
  x.send();
}
</script>

</body>
</html>
