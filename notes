<?php 
$conn=mysqli_connect("localhost","root","1913920@Smit","college1"); 
if(!$conn) 
    { 
    die("Connection error:".mysqli_connect_error()); 
    } 
    $id=1;  
    $name="Smit"; 
    $sql="INSERT INTO STUDENT(id,name) VALUES('$id','$name')"; 
    if (mysqli_query($conn,$sql)){         echo "Records inserted successfully"; 
    } 
    else{         echo "error:".mysqli_error($conn); 
    } 
   mysqli_close($conn); 


