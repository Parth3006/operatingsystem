-----------------TASKMANAGER------------



<!DOCTYPE html>
<html>
<head>
<title>To-Do List</title>
</head>
<body>
<h2>To-Do List</h2>
<input id="task" placeholder="Enter task">
<button onclick="addTask()">Add</button>
<ul id="list"></ul>
<script>
function addTask() {
    let input = document.getElementById("task");
    let list = document.getElementById("list");
    let t = input.value;
    if (t.trim() === "") {
        alert("Enter a task!");
        return;
    }
    let li = document.createElement("li");
    li.innerHTML = `
        <span>${t}</span>
        <button onclick="markDone(this)">Done</button>
        <button onclick="deleteTask(this)">Delete</button>
    `;
    list.appendChild(li);
    input.value = "";
}
function markDone(btn) {
    let text = btn.parentElement.querySelector("span");
    text.style.textDecoration = "line-through";
}
function deleteTask(btn) {
    btn.parentElement.remove();
}
</script>
</body>
</html>


---------TOGGLE,SHOW,HIDE,ANIMATION----------

<html>
<head>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body class="text-center">
<br>

<button class="btn btn-primary m-1" onclick="$('#box').hide()">Hide</button>
<button class="btn btn-success m-1" onclick="$('#box').show()">Show</button>
<button class="btn btn-danger m-1" onclick="$('#box').toggle()">Toggle</button>

<button class="btn btn-warning m-1" onclick="
$('#box')
.animate({left:'100px'})
.animate({left:'-100px'})
.animate({left:'0px'})
">
Animate
</button>

<p id="box" style="background:blue; width:200px; height:100px; margin: 20px auto; position:relative;">
    Box
</p>

</body>
</html>


