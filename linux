-----------Q1. Apply awk command on suitable data. Describe respective commands -------------

touch marks.txt
cat> marks.txt
cat marks.txt
1. Print Full File
awk '{print}' marks.txt
2. Print Roll No + Name
awk '{print $1,$2}' marks.txt
3. Print Only Names
awk '{print $2}' marks.txt
4. Print Only Marks
awk '{print $3}' marks.txt
5. Marks > 80
awk '$3>80 {print $2,$3}' marks.txt
6. Count Marks > 80
awk '$3>80 {count++} END {print count}' marks.txt
7. Sum of Marks
awk '{sum+=$3} END {print sum}' marks.txt

